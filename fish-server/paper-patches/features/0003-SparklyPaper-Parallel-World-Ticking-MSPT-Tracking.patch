From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MrPowerGamerBR <git@mrpowergamerbr.com>
Date: Sun, 25 May 2025 21:39:32 -0300
Subject: [PATCH] SparklyPaper Parallel World Ticking MSPT Tracking


diff --git a/src/main/java/io/papermc/paper/command/PaperMSPTCommand.java b/src/main/java/io/papermc/paper/command/PaperMSPTCommand.java
index c4e9a5771f8015c75bbd16c04040607d8c7e5fbd..f5d11bf6d498749027ae4fa50d8c5676492c7b43 100644
--- a/src/main/java/io/papermc/paper/command/PaperMSPTCommand.java
+++ b/src/main/java/io/papermc/paper/command/PaperMSPTCommand.java
@@ -76,6 +76,47 @@ public class PaperMSPTCommand {
                 )
             )
         );
+        // SparklyPaper start - track world's MSPT
+        if (me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED) {
+            sender.sendMessage(text());
+            sender.sendMessage(text().content("World tick times ").color(GOLD)
+                .append(text().color(YELLOW)
+                    .append(
+                        text("("),
+                        text("avg", GRAY),
+                        text("/"),
+                        text("min", GRAY),
+                        text("/"),
+                        text("max", GRAY),
+                        text(")")
+                    )
+                ).append(
+                    text(" from last 5s"),
+                    text(",", GRAY),
+                    text(" 10s"),
+                    text(",", GRAY),
+                    text(" 1m"),
+                    text(":", YELLOW)
+                )
+            );
+            for (net.minecraft.server.level.ServerLevel serverLevel : server.getAllLevels()) {
+                List<Component> worldTimes = new ArrayList<>();
+                worldTimes.addAll(eval(serverLevel.fish$tickTimes5s));
+                worldTimes.addAll(eval(serverLevel.fish$tickTimes10s));
+                worldTimes.addAll(eval(serverLevel.fish$tickTimes60s));
+
+                sender.sendMessage(text().content("◴ " + serverLevel.getWorld().getName() + ": ").color(GOLD)
+                    .append(text().color(GRAY)
+                        .append(
+                            worldTimes.get(0), SLASH, worldTimes.get(1), SLASH, worldTimes.get(2), text(", ", YELLOW),
+                            worldTimes.get(3), SLASH, worldTimes.get(4), SLASH, worldTimes.get(5), text(", ", YELLOW),
+                            worldTimes.get(6), SLASH, worldTimes.get(7), SLASH, worldTimes.get(8)
+                        )
+                    )
+                );
+            }
+        }
+        // SparklyPaper end
         return Command.SINGLE_SUCCESS;
     }
 
