Subject: [PATCH] Fish Mid Tick Tasks Experiment 1


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
index 640548d78b87653871dd1f7b0f84574c5e205fe8..28de2b7f1d9e83561083c115b607c7eb15e8d728 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
@@ -831,6 +831,9 @@ public final class ChunkTaskScheduler {
      */
     @Deprecated
     public PrioritisedExecutor.PrioritisedTask scheduleChunkTask(final Runnable run, final Priority priority) {
+        if (me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED && me.biquaternions.fish.async.thread.WorldTickThread.isWorldTickThread()) {
+            return this.world.fish$worldData.taskQueue.queueTask(run, priority);
+        }
         return this.mainThreadExecutor.queueTask(run, priority);
     }
 
@@ -840,6 +843,9 @@ public final class ChunkTaskScheduler {
 
     public PrioritisedExecutor.PrioritisedTask createChunkTask(final int chunkX, final int chunkZ, final Runnable run,
                                                                final Priority priority) {
+        if (me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED && me.biquaternions.fish.async.thread.WorldTickThread.isWorldTickThread()) {
+            return this.world.fish$worldData.taskQueue.createTask(run, priority);
+        }
         return this.mainThreadExecutor.createTask(run, priority);
     }
 
@@ -849,6 +855,9 @@ public final class ChunkTaskScheduler {
 
     public PrioritisedExecutor.PrioritisedTask scheduleChunkTask(final int chunkX, final int chunkZ, final Runnable run,
                                                                  final Priority priority) {
+        if (me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED && me.biquaternions.fish.async.thread.WorldTickThread.isWorldTickThread()) {
+            return this.world.fish$worldData.taskQueue.queueTask(run, priority);
+        }
         return this.mainThreadExecutor.queueTask(run, priority);
     }
 
diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index f3cdeab98548a9d1eb06289f447b7274ccb7913f..9d2086bdb304b0f349b6b058518bbeecebc89e94 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -875,6 +875,12 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
             if (ServerChunkCache.this.runDistanceManagerUpdates()) {
                 return true;
             }
+            if (me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED && me.biquaternions.fish.async.thread.WorldTickThread.isWorldTickThread()) {
+                if (ServerChunkCache.this.level != me.biquaternions.fish.threadedregions.TickWorldScheduler.getCurrentRegionizedWorldData().world) {
+                    throw new IllegalStateException("Polling tasks from non-owned world");
+                }
+                return me.biquaternions.fish.threadedregions.TickWorldScheduler.getCurrentRegionizedWorldData().executeWorldThreadTask();
+            }
 
             // Paper - rewrite chunk system
             return super.pollTask() | ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)ServerChunkCache.this.level).moonrise$getChunkTaskScheduler().executeMainThreadTask(); // Paper - rewrite chunk system
