From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Biquaternions <biquaternions@serlith.net>
Date: Mon, 28 Jul 2025 13:00:38 -0500
Subject: [PATCH] Fish Fix Handle Entity Portal Teleport

Used this snippet from Leaf's version as a reference to fix:
https://github.com/Winds-Studio/Leaf/blob/3268a57db808ad2a371cb28c5fea4cb2edc2e426/leaf-server/minecraft-patches/features/0210-SparklyPaper-Parallel-world-ticking.patch#L851

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index f60535cc3d55099e8dd489db9e15af1ebe9e754e..44f5991b1ba83de2e72a9e0cd76eb92b3092e063 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -870,7 +870,6 @@ public abstract class Entity
     // CraftBukkit start
     public void postTick() {
         // No clean way to break out of ticking once the entity has been copied to a new world, so instead we move the portalling later in the tick cycle
-        if (!me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED) // SparklyPaper - parallel world ticking (see issue #9, this is executed in the server level tick for non-player entities)
         if (!(this instanceof ServerPlayer) && this.isAlive()) { // Paper - don't attempt to teleport dead entities
             this.handlePortal();
         }
@@ -3587,6 +3586,29 @@ public abstract class Entity
                     ProfilerFiller profiler = Profiler.get();
                     profiler.push("portal");
                     this.setPortalCooldown();
+                    // Fish start - Handle entity portal teleport
+                    if (me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED) {
+                        this.portalProcess.fish$setPending(true);
+                        this.getBukkitEntity().taskScheduler.schedule(e -> {
+                            PortalProcessor processor = e.portalProcess;
+                            if (processor == null) return;
+                            if (!processor.fish$isPending()) {
+                                e.portalProcess = null;
+                                return;
+                            }
+                            TeleportTransition teleportTransition = this.portalProcess.getPortalDestination(level, this);
+                            if (teleportTransition != null) {
+                                ServerLevel newLevel = teleportTransition.newLevel();
+                                if (level.isAllowedToEnterPortal(newLevel) && (newLevel.dimension() == level.dimension() || this.canTeleport(level, newLevel))) {
+                                    this.teleport(teleportTransition);
+                                }
+                            }
+                            processor.fish$setPending(false);
+                        }, e -> {}, 0);
+                        profiler.pop();
+                        return;
+                    }
+                    // Fish end - Handle entity portal teleport
                     TeleportTransition teleportTransition = this.portalProcess.getPortalDestination(level, this);
                     if (teleportTransition != null) {
                         ServerLevel newLevel = teleportTransition.newLevel();
diff --git a/net/minecraft/world/entity/PortalProcessor.java b/net/minecraft/world/entity/PortalProcessor.java
index 7ec15f3d3a770e1e9e2fbac29dd38e947bb07091..711951b696ef9ff6e021308eaad3541f56350205 100644
--- a/net/minecraft/world/entity/PortalProcessor.java
+++ b/net/minecraft/world/entity/PortalProcessor.java
@@ -19,6 +19,7 @@ public class PortalProcessor {
     }
 
     public boolean processPortalTeleportation(final ServerLevel serverLevel, final Entity entity, final boolean allowedToTeleport) {
+        if (me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED && this.fish$isPending()) return false; // Fish - Handle entity portal teleport
         if (!this.insidePortalThisTick) {
             this.decayTick();
             return false;
@@ -41,6 +42,7 @@ public class PortalProcessor {
     }
 
     public boolean hasExpired() {
+        if (me.biquaternions.fish.FishConfig.ASYNC.WORLD_TICKING._ENABLED) return !this.fish$isPending() && this.portalTime <= 0; // Fish - Handle entity portal teleport
         return this.portalTime <= 0;
     }
 
@@ -67,4 +69,14 @@ public class PortalProcessor {
     public boolean isSamePortal(final Portal portal) {
         return this.portal == portal;
     }
+
+    // Fish start - Handle entity portal teleport
+    private volatile boolean fish$pending = false;
+    public void fish$setPending(boolean pending) {
+        this.fish$pending = pending;
+    }
+    public boolean fish$isPending() {
+        return this.fish$pending;
+    }
+    // Fish end - Handle entity portal teleport
 }
